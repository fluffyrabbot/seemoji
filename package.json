{
  "name": "seemoji",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:storage-stress": "SEEMOJI_STATE_SEEDS=24 SEEMOJI_STATE_STEPS=200 vitest run src/adapters/browser/indexedDbProjectRepository.state.test.ts",
    "test:controller-stress": "SEEMOJI_CONTROLLER_SEEDS=24 SEEMOJI_CONTROLLER_STEPS=160 vitest run src/application/workspaceController.state.test.ts",
    "test:persistence-stress": "npm run test:storage-stress && npm run test:controller-stress",
    "test:delivery": "node --test scripts/check-deployed-headers.test.mjs",
    "test:e2e": "npm run build && playwright test --project=chromium",
    "test:e2e:compat": "npm run build && playwright test --project=firefox --project=webkit",
    "test:e2e:all": "npm run build && playwright test",
    "lint": "oxlint",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:deployed": "node scripts/check-deployed-headers.mjs",
    "check": "npm run lint && npm run test:unit && npm run test:delivery && npm run build && npm run check:bundle && playwright test --project=chromium",
    "check:compat": "npm run check && playwright test --project=firefox --project=webkit",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.12",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.127.0"
  },
  "dependencies": {
    "preact": "^10.29.8"
  }
}
